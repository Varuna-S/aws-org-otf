# Local .terraform & terragrunt directories
**/.terraform/*


# .tfstate files
*.tfstate
*.tfstate.*


# Crash log files
crash.log


# Exclude all .tfvars files, which are likely to contain sentitive data
*.tfvars


# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json


# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*tfplan*


# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terragrunt
.terragrunt-cache

# .tfvars without any secrets
!common.tfvars
!regional.tfvars

# Ignore sensitive information
.envrc
